generator client {
  provider        = "prisma-client-js"
  // Rust-free client (query compiler + driver adapter) so the same client runs on Node and Cloudflare Workers
  previewFeatures = ["driverAdapters", "queryCompiler"]
  engineType      = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanId {
  trial
  pro
  max
}

enum EntitlementStatus {
  trialing
  active
  past_due
  canceled
}

enum MessageRole {
  user
  assistant
}

enum MessageStatus {
  complete
  streaming
  error
  stopped
}

enum ReservationStatus {
  reserved
  settled
  released
}

model User {
  id            String         @id @default(cuid())
  email         String?        @unique
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  sessions      Session[]
  entitlement   Entitlement?
  conversations Conversation[]
  projects      Project[]
  messages      Message[]
  reservations  UsageReservation[]
  modelSettings UserModelSettings[]
  loginSessions LoginSession[]
  referral      Referral?
  referralsMade ReferralAttribution[] @relation("ReferralReferrer")
  referredBy    ReferralAttribution?  @relation("ReferralReferred")
  bannedAt      DateTime?
  bannedReason  String?
  filterLogs    FilterRefusalLog[]
  adminActions  AdminAuditLog[]  @relation("AdminActor")
  adminTargets  AdminAuditLog[]  @relation("AdminTarget")
}

// Auth.js (NextAuth v5) adapter tables
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// One row per user. Row-locked (SELECT ... FOR UPDATE) for every usage reservation.
model Entitlement {
  userId               String            @id
  plan                 PlanId            @default(trial)
  status               EntitlementStatus @default(trialing)
  trialUsed            Int               @default(0)
  periodUsed           Int               @default(0)
  reserved             Int               @default(0)
  periodStart          DateTime?
  periodEnd            DateTime?
  windowUsed           Int               @default(0)
  windowStart          DateTime?
  windowEnd            DateTime?
  weekUsed             Int               @default(0)
  weekStart            DateTime?
  weekEnd              DateTime?
  refundMarkedAt       DateTime?
  cancelAtPeriodEnd    Boolean           @default(false)
  stripeCustomerId     String?           @unique
  stripeSubscriptionId String?           @unique
  updatedAt            DateTime          @updatedAt
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageReservation {
  id                 String            @id @default(cuid())
  userId             String
  units              Int
  status             ReservationStatus @default(reserved)
  pool               String // "trial" | "period"
  assistantMessageId String?
  createdAt          DateTime          @default(now())
  settledAt          DateTime?
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Project {
  id            String         @id @default(cuid())
  userId        String
  name          String
  instructions  String         @default("")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([userId, updatedAt])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  projectId String?
  title     String    @default("New chat")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages  Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  userId         String
  role           MessageRole
  content        String        @default("")
  status         MessageStatus @default(complete)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// One-time 6-digit email login codes. Stored hashed; 6-digit OTP (not magic links).
model EmailLoginCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  requestIp  String?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@index([requestIp, createdAt])
}

// Stripe webhook idempotency ledger
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

model UserModelSettings {
  id           String   @id @default(cuid())
  userId       String
  modelId      String
  systemPrompt String   @default("")
  temperature  Float?
  maxTokens    Int?
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, modelId])
}

model LoginSession {
  id         String    @id @default(cuid())
  userId     String
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipHash     String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model Referral {
  userId    String   @id
  code      String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Who invited whom. One row per referred account (first code wins, locked at signup, or a manual log entry).
// status: pending -> crediting -> credited, or rejected / capped / expired / voided / reversed. See lib/referrals.ts.
model ReferralAttribution {
  id                  String    @id @default(cuid())
  referrerUserId      String
  referredUserId      String    @unique
  code                String
  source              String    @default("link")
  status              String    @default("pending")
  reason              String?
  referredCustomerId  String?
  firstPaidInvoiceId  String?
  firstPaidAt         DateTime?
  rewardKind          String?
  rewardCents         Int       @default(0)
  rewardDays          Int       @default(0)
  rewardEndsAt        DateTime?
  referrerCustomerId  String?
  referrerCreditTxnId String?
  reversalTxnId       String?
  creditedAt          DateTime?
  reversedAt          DateTime?
  flagReason          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  referrer            User      @relation("ReferralReferrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referred            User      @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerUserId, status])
  @@index([referredCustomerId])
}

model GuestQuota {
  id        String   @id @default(cuid())
  guestId   String   @unique
  ipHash    String
  used      Int      @default(0)
  reserved  Int      @default(0)
  dayUsed   Int      @default(0)
  dayStart  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ipHash])
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String
  action       String
  targetUserId String?
  detail       String   @default("")
  createdAt    DateTime @default(now())
  actor        User     @relation("AdminActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  target       User?    @relation("AdminTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetUserId])
}

model FilterRefusalLog {
  id        String   @id @default(cuid())
  userId    String?
  guestId   String?
  direction String
  category  String
  modelId   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}

model WaitlistSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String
  createdAt DateTime @default(now())
  ipHash    String

  @@index([createdAt])
  @@index([ipHash])
}


// Durable fixed-window rate-limit counters (shared across Workers isolates). key is a hashed bucket id.
model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
}
