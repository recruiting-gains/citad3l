# ---------- Core ----------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/citad3l"   # Fly Postgres / Neon / Supabase
APP_URL="https://your-domain.example"                          # used for Stripe return URLs
AUTH_SECRET="generate with: npx auth secret"                   # REQUIRED in production
AUTH_TRUST_HOST=true

# ---------- Auth (Auth.js v5) ----------
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
DEMO_LOGIN_ENABLED=false    # dev-only demo login; ALWAYS refused when NODE_ENV=production

# Email OTP (6-digit code, not a magic link). In local dev, codes are printed to the server console
# when no real sender is configured. Production needs a sender + a verified domain (workers.dev cannot be used).
AUTH_EMAIL_FROM="Citad3L <login@citad3l.io>"
RESEND_API_KEY=             # optional (AUTH_RESEND_KEY also accepted). Without a verified domain,
                            # Resend's onboarding@resend.dev sender can only mail the Resend account owner.
# Cloudflare Email Sending uses the EMAIL send_email binding in wrangler.jsonc (no API key).

# ---------- Inference (server-only; any chat-completions server) ----------
INFERENCE_PROVIDER=compatible   # "mock" only for local dev (refused in production)
INFERENCE_BASE_URL=https://gpu-host.internal:8080/v1
INFERENCE_MODEL=citad3l-v1  # model alias served by your inference server
INFERENCE_API_KEY=          # your inference server's API key
INFERENCE_MAX_TOKENS=2048

# ---------- Hosted provider (server-only; never expose to the client bundle) ----------
# When no provider key is set, the app uses the mock provider in development.
PROVIDER_API_KEY=
# PROVIDER_BASE_URL=https://provider.example/api/v1
# PROVIDER_WIRE={"params":"...","noSystemPrompt":"...","headerPrefix":"...","mediaHost":"..."}
# MODEL_IDS={"citad3l-v1":"...","citad3l-fast":"...","citad3l-private":"...","citad3l-image":"...","video-t2v":"...","video-i2v":"...","computer":"..."}
# MODEL_IDS_V2={"gemma4-uncensored":"...","uncensored-1.2":"...","glm5.3-flash-uncensored":"...","roleplay-uncensored":"...","inkling2-mini":"...","qwen3.8-27b":"...","qwen4-max":"...","grok-4.7":"...","kimi-k3.1-pro":"...","kimi-k2.7-code":"..."}  # merged under MODEL_IDS; MODEL_IDS wins on conflict
# Citad3L Video stays hidden until pricing is confirmed:
# CITAD3L_VIDEO_ENABLED=false
# Image and video generation are off unless this is exactly true:
# MEDIA_GENERATION_ENABLED=false

# ---------- Safety filter ----------
# Hard lines (CSAM, explosives) cannot be turned off.
# Adult sexual content is banned by default. Set true only after a legal/processor decision:
# CITAD3L_ALLOW_ADULT=false
# Optional second-pass classifier using Citad3L Fast (costs tokens; off by default):
# CITAD3L_FILTER_LLM=false

# ---------- Plans / limits ----------
PRO_MONTHLY_UNITS=600       # replies per month for Pro; Max = 2.5x. LOAD-TEST BEFORE SALE.
MAX_CONCURRENT_STREAMS_PER_USER=2
RATE_LIMIT_PER_MINUTE=20

# ---------- Stripe (TEST mode only; this build refuses sk_live_ keys) ----------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...  # recurring $20/month test price
STRIPE_PRICE_MAX=price_...  # recurring $50/month test price

# ---------- Operator ----------
# Owner/admin emails (set as Worker secrets in production). Only the owner can open /admin.
# CITAD3L_OWNER_EMAIL=
# CITAD3L_ADMIN_EMAILS=   # comma-separated
# SWARM_WEB_SEARCH_EMAILS=   # comma-separated; Swarm web search for these accounts only (empty = off for everyone)

# ---------- Usage windows (paid plans) ----------
# Replaces the single monthly pool. Pro window/week below; Max is 2.5× each.
# USAGE_WINDOW_MS=18000000
# USAGE_WEEK_MS=604800000
# PRO_WINDOW_UNITS=25
# PRO_WEEKLY_UNITS=150
# PRO_MONTHLY_UNITS is no longer used for limits (kept only if older docs mention it).

# Cloudflare Turnstile (bot check on login-code + waitlist). OFF unless BOTH are set.
# TURNSTILE_SITE_KEY=0x4AAAA...        # public site key (wrangler var)
# TURNSTILE_SECRET_KEY=0x4AAAA...      # secret (wrangler secret put TURNSTILE_SECRET_KEY)
# CITAD3L_TURNSTILE=off                # force off
# CSP rollout: report-only (default) | enforce | off
# CITAD3L_CSP=report-only
# ALLOWED_ORIGINS=https://citad3l.example.workers.dev
